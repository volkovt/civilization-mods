    <ModContent>
      <Content xmlns="">
        <Type>InGameUIAddin</Type>
        <Name>Sayajin Hero Control</Name>
        <Description>Synchronizes Sayajin heroes, transformations and the Monument empire bonus.</Description>
        <FileName>Lua/Sayajin_HeroControl.lua</FileName>
      </Content>
    </ModContent>
    <ModDependencies>
