<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Deploy" ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Default</Configuration>
    <ProjectGuid>{bae703f5-0ec4-4867-bf3b-db84e46228b3}</ProjectGuid>
    <Name>Sayajins</Name>
    <Guid>1781f473-6f84-4258-b88a-a837cbd85611</Guid>
    <ModVersion>11</ModVersion>
    <Stability>Beta</Stability>
    <Teaser>Nação Sayajin com cinco heróis, evoluções e ataques animados</Teaser>
    <Description>Nação Sayajin liderada por Vegeta, com Goku, Gohan, Piccolo e Broly em modelos próprios, cabelos específicos por transformação, golpes de ki animados e explosões nucleares nativas nas duas formas finais.</Description>
    <Authors>Diego Melo</Authors>
    <SpecialThanks>
    </SpecialThanks>
    <AffectsSavedGames>true</AffectsSavedGames>
    <MinCompatibleSaveVersion>0</MinCompatibleSaveVersion>
    <SupportsSinglePlayer>true</SupportsSinglePlayer>
    <SupportsMultiplayer>false</SupportsMultiplayer>
    <SupportsHotSeat>true</SupportsHotSeat>
    <SupportsMac>true</SupportsMac>
    <ReloadUnitSystem>true</ReloadUnitSystem>
    <AssemblyName>sayajins</AssemblyName>
    <RootNamespace>sayajins</RootNamespace>
    <ModReferences>
      <Association>
        <Type>Mod</Type>
        <Name>(2) Vox Populi</Name>
        <Id>8411a7a8-dad3-4622-a18e-fcc18324c799</Id>
        <MinVersion>0</MinVersion>
        <MaxVersion>999</MaxVersion>
      </Association>
    </ModReferences>
    <ModProperties>
    </ModProperties>
    <ModActions>
      <Action>
        <Set>OnModActivated</Set>
        <Type>UpdateDatabase</Type>
        <FileName>Text/Sayajin_Text.xml</FileName>
      </Action>
